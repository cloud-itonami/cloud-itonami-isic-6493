;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": for factoring (ISIC 6493) a document-custody
;; robot manages physical invoices, assignment-notification paperwork and
;; KYC records, gated by the independent Factoring Governor. Physical work
;; modelled here: the robot drawing an invoice binder out of a filing-cabinet
;; drawer, and the fire protection of the data-media safe that holds the
;; KYC record backups.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-6493"
 :cases
 [{:id :invoice-binder-from-drawer
   :kind :manipulator
   :procedure "custody robot lifts an invoice binder out of an open filing-cabinet drawer and raises it onto its document tray"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 -0.20] :to [0.30 0.50] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [1.0 2.0 3.5 5.0 7.0]}
   :quantity :peak-tau1-nm
   :limit {:max 70.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm class"}
   :boundary {:lo 0.2 :hi 30.0}}
  {:id :kyc-media-safe-fire
   :kind :thermal
   :procedure "insulated wall of the data-media safe holding the KYC record backups, exposed to a standard building fire"
   :params {:conductivity-w-mk 0.05 :density-kg-m3 300.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :hot-curve :iso-834 :h-front-w-m2k 25.0 :t-back-ambient-c 20.0 :h-back-w-m2k 2.0
            :threshold-c 52.0 :duration-s 14400.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.03 0.04 0.05 0.06 0.08]}
   :quantity :time-to-threshold-s
   :limit {:min 3600.0 :basis "UL 72 Class 125, 1-hour rating: a data-media container's interior must stay at or below 52 C (125 F); UL 72 uses the ASTM E119 furnace curve, approximated here by ISO 834; the insulation's k/rho/cp are estimates"}
   :boundary {:lo 0.02 :hi 0.08}}]}
